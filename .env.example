# Mausam Saathi environment variables (PRD section 13.11).
# Copy to .env.local. Anything without NEXT_PUBLIC_ stays on the server and
# is never sent to the browser. Never put an API key in a NEXT_PUBLIC_ var.

# ── Official warnings ──────────────────────────────────────────────────────

# IMD APIs (https://api.imd.gov.in/public/api_reference.html). IMD only
# answers whitelisted IP addresses (verified 30 Sep 2026: HTTP 401 "IP ...
# needs to be whitelisted"). Serverless hosts have no fixed IP, so either
# route through a whitelisted static-IP proxy or leave this off.
IMD_API_ENABLED=false
IMD_API_BASE_URL=https://api.imd.gov.in
# IMD_PROXY_BASE_URL=https://your-static-ip-proxy.example

# NDMA SACHET CAP feeds, comma separated. Public, no key. The all-India feed
# works today; state feeds are listed at https://sachet.ndma.gov.in/CapFeed.
# Unset means SACHET is off and the app says it could not check warnings.
SACHET_FEED_URLS=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml

# ── Weather and air ────────────────────────────────────────────────────────

# CPCB real-time AQI via data.gov.in (free key). Unset means AQI is computed
# from Open-Meteo model PM2.5/PM10 and labelled as an estimate.
# DATA_GOV_IN_API_KEY=
# CPCB_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Self-hosted or paid Open-Meteo. Unset uses the free public API
# (non-commercial terms; check them before a government deployment).
# OPEN_METEO_BASE_URL=

# Airport METAR/TAF (free public NOAA service).
AVIATION_WEATHER_BASE_URL=https://aviationweather.gov/api/data

# ── Demo and testing ───────────────────────────────────────────────────────

# Shows the "Demo scenarios" switch in Settings. Set true for judging.
NEXT_PUBLIC_DEMO_MODE=false

# Serve fixture weather instead of calling providers (tests, offline demos).
# Official warnings are still never faked: they report "unavailable".
FORCE_FIXTURES=false

# ── Storage (Part 3) ───────────────────────────────────────────────────────

# Postgres for crowd reports, feedback and push subscriptions. Unset means
# the in-memory adapter, which loses data on restart.
# DATABASE_URL=
# REDIS_URL=
# Key for GET /api/mausam/reports/export (header x-export-key); at least 16
# characters. Unset disables the export.
# REPORTS_EXPORT_KEY=
# Salt for hashing report device ids. Unset means a random salt per server
# start, so hashes cannot be linked across restarts (more private, but rate
# limits reset on restart).
# REPORTS_SALT=

# ── Notifications (Part 3) ─────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:team@example.com
# CRON_SECRET=

# ── Languages and voice (Part 3) ───────────────────────────────────────────
# BHASHINI_USER_ID=
# BHASHINI_ULCA_API_KEY=
# BHASHINI_PIPELINE_ID=

# ── Optional services (Part 3) ─────────────────────────────────────────────
# NOWCAST_BASE_URL=          # pySTEPS radar nowcast service; unset hides it
# MITRA_LLM_ENABLED=false    # grounded LLM rephrasing for Mausam Mitra
# LLM_PROVIDER=
# LLM_API_KEY=

# ── Optional sign-in (kept from SaathiSync; hidden from main navigation) ───
NEXT_PUBLIC_API_BASE_URL=https://sih24-backend.onrender.com
LEGACY_AUTH_BASE_URL=https://sih24-backend.onrender.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_BRIDGE_SECRET=

# The /api/v1 boundary and its in-memory store are kept as tested
# infrastructure (PRD 14.1); the UI does not use them.
# DATABASE_URL above also backs /api/v1 when an adapter exists.

# ── Site and contact (Part 3E) ─────────────────────────────────────────────
# Public origin for sitemap.xml and robots.txt, e.g. https://mausam-saathi.vercel.app
# SITE_URL=
# Optional contact details shown on /contact (GIGW G11). When unset, the
# contact page points to the feedback form.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_REPO_URL=
