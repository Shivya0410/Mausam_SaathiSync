# Base URL of the Swasth Infinity backend. The app appends /api/auth and
# /api/admin to this value. Production deployments point at the hosted backend.
NEXT_PUBLIC_API_BASE_URL=https://sih24-backend.onrender.com

# Floating WhatsApp button (bottom-right, site-wide). Business number in
# country-code format without "+" — used for the wa.me chat link.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Condition-based yoga pose suggestions (src/components/yogahealth/yoga.js).
# The underlying condition-to-pose mapping is not clinically reviewed and its
# results carry no source or review metadata, so this is off by default.
# Set to "true" only for a demo, where the in-app disclaimer is also shown.
NEXT_PUBLIC_ENABLE_CONDITION_SUGGESTIONS=false

# Google sign-in (Google Identity Services + backend exchange).
# 1. Google Cloud Console > APIs & Services > Credentials > Create OAuth client
#    ID (type: Web application).
# 2. Add Authorized JavaScript origins: http://localhost:3000 and your prod URL.
# 3. Paste the client ID here (it ends with .apps.googleusercontent.com).
# 4. Backend must implement POST /api/auth/google { credential } -> { token }
#    by verifying the credential with google-auth-library verifyIdToken.
# Without this, the Google button shows a setup notice and email login is used.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-only (never NEXT_PUBLIC_): secret for the /api/auth/google bridge,
# which verifies the Google credential and signs the user into the legacy
# backend until the backend gains a native Google route. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later locks out Google-created accounts.
# GOOGLE_BRIDGE_SECRET=

# --- Server-only settings (no NEXT_PUBLIC_ prefix: never sent to the browser) ---

# Identity backend used by the /api/v1 boundary to verify bearer tokens.
# Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
LEGACY_AUTH_BASE_URL=https://sih24-backend.onrender.com

# Python recommendation service. Not implemented yet; see contracts/api-v1.md.
# RECOMMENDER_BASE_URL=
# RECOMMENDER_SERVICE_KEY=

# Durable store. Unset means the in-memory adapter, which loses data on
# restart. GET /api/v1/health reports which adapter is live.
# DATABASE_URL=

# --- Feature flags (section 12.2) ---

# Camera and TensorFlow pose practice. Off by default: the recommendation
# path must work without a camera or a model.
FEATURE_CV_PRACTICE=false

# "demo" is the only supported value. There is no clinical release mode.
RECOMMENDATION_MODE=demo
